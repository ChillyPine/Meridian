	"authors": [
		"DwnInFraggleRock",
		"ChillyPine"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/ChillyPine/Meridian",
		"issues" : "https://github.com/ChillyPine/Meridian/issues"
	},
	"license": "MIT",
	"icon": "assets/meridian/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "io.github.meridian.Meridian",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"meridian.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
